# Provider: "openai" (OpenAI-compatible, e.g. OpenRouter) or "gemini" (Google AI official)
LLM_PROVIDER=openai

# --- OpenAI-compatible provider (OpenRouter by default; also OpenAI / Azure) ---
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL_NAME=google/gemini-3.1-pro-preview
# OPENAI_REASONING_EFFORT=medium     # optional: minimal | low | medium | high

# --- Google AI official provider (set LLM_PROVIDER=gemini to use this instead) ---
# GEMINI_API_KEY=your-google-ai-studio-key
# GEMINI_MODEL_NAME=gemini-3.1-pro-preview
# GEMINI_API_ENDPOINT=https://your-gateway.example.com   # optional custom gateway/proxy
